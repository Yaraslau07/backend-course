NODE_ENV=development
# --- Server ---
PORT=3007
TRUST_PROXY=false
PUBLIC_API_BASE_URL=http://localhost:3007
FRONTEND_URL=http://localhost:5173
# Exact origins, comma-separated. Never "*".
CORS_ORIGINS=http://localhost:5173
# Secure cookies don't round-trip over plain http://localhost in every HTTP client.
# false is allowed only outside production (validation enforces it).
COOKIE_SECURE=false
# strict (default), or none for a frontend on another site; none requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=strict
READINESS_ALLOWED_IPS=127.0.0.1,::1

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=false

# --- JWT ---
JWT_ISSUER=backend-course
JWT_AUDIENCE=backend-course-api

# --- Flows ---
REGISTRATION_EMAIL_CONFIRMATION_ENABLED=false
REGISTRATION_EMAIL_CONFIRMATION_METHOD=otp
LOGIN_EMAIL_CONFIRMATION_ENABLED=false
LOGIN_EMAIL_CONFIRMATION_METHOD=otp
EMAIL_CHANGE_METHOD=otp
DELETION_CONFIRMATION_METHOD=otp
REGISTRATION_RATE_LIMIT_PER_HOUR=10
# Existing user id that bootstrap makes admin (optional until RBAC exists)
RBAC_BOOTSTRAP_ADMIN_USER_ID=
DELETION_WORKER_LEASE_SECONDS=300

# Conversions (Part 2): a private temp directory (empty = <os tmpdir>/backend-course-transformations)
# and the converter worker threads.
TRANSFORMATION_TEMP_DIR=
TRANSFORMATION_WORKER_THREADS=2
# Transformation history retention (spec 2.3), in days.
TRANSFORMATION_HISTORY_RETENTION_DAYS=90
# How long a saved result is kept once stored (spec 2.4), in days.
TRANSFORMATION_STORED_FILE_RETENTION_DAYS=90
# Text conversion (spec 2.1): input limit per format in bytes, and the timeout.
TEXT_CSV_MAX_BYTES=10485760
TEXT_JSON_MAX_BYTES=10485760
TEXT_XML_MAX_BYTES=10485760
TEXT_YAML_MAX_BYTES=10485760
TEXT_CONVERSION_TIMEOUT_MS=30000
# Image conversion (spec 2.2): input limit per format in bytes, and the timeout.
IMAGE_PNG_MAX_BYTES=10485760
IMAGE_JPEG_MAX_BYTES=10485760
IMAGE_SVG_MAX_BYTES=10485760
IMAGE_CONVERSION_TIMEOUT_MS=30000

# --- SMTP (Mailpit from docker-compose) ---
# Private photo storage: local development/test or S3; see docs/storage-setup.md.
STORAGE_LOCAL_ROOT=.storage
# local in development/test; production defaults to s3 and requires its credentials.
STORAGE_DRIVER=local
STORAGE_WORKERS_ENABLED=true
S3_REGION=
S3_BUCKET=
S3_PREFIX=photos/
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for an S3-compatible service (leave empty for AWS).
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Backend Course <no-reply@example.com>

# --- Secrets ---
# Every key: base64url, at least 32 random bytes, all different from each other.
# Fill them with:  npm run keys:generate >> .env   (then delete these empty lines)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
REGISTRATION_CHALLENGE_HMAC_KEY=
LOGIN_CHALLENGE_HMAC_KEY=
EMAIL_CHANGE_HMAC_KEY=
DELETION_CHALLENGE_HMAC_KEY=
LOG_PSEUDONYM_HMAC_KEY=
# Rate-limit counters store HMACs of IPs, emails and user ids, never the values
RATE_LIMIT_KEY_HMAC_KEY=
# Cursor key ring "kid:key,kid:key"; the active kid must be in the ring.
USER_LIST_CURSOR_ACTIVE_KEY_ID=
USER_LIST_CURSOR_HMAC_KEYS=
