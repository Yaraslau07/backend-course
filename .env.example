NODE_ENV=development
# --- Server ---
PORT=3007
TRUST_PROXY=false
PUBLIC_API_BASE_URL=http://localhost:3007
FRONTEND_URL=http://localhost:5173
# Exact origins, comma-separated. Never "*".
CORS_ORIGINS=http://localhost:5173
# Secure cookies don't round-trip over plain http://localhost in every HTTP client.
# false is allowed only outside production (validation enforces it).
COOKIE_SECURE=false
READINESS_ALLOWED_IPS=127.0.0.1,::1

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=false

# --- JWT ---
JWT_ISSUER=backend-course
JWT_AUDIENCE=backend-course-api

# --- Flows ---
REGISTRATION_EMAIL_CONFIRMATION_ENABLED=false
REGISTRATION_EMAIL_CONFIRMATION_METHOD=otp
LOGIN_EMAIL_CONFIRMATION_ENABLED=false
LOGIN_EMAIL_CONFIRMATION_METHOD=otp
EMAIL_CHANGE_METHOD=otp
DELETION_CONFIRMATION_METHOD=otp
REGISTRATION_RATE_LIMIT_PER_HOUR=10
# Existing user id that bootstrap makes admin (optional until RBAC exists)
RBAC_BOOTSTRAP_ADMIN_USER_ID=
DELETION_WORKER_LEASE_SECONDS=300

# --- SMTP (Mailpit from docker-compose) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Backend Course <no-reply@example.com>

# --- Secrets ---
# Every key: base64url, at least 32 random bytes, all different from each other.
# Fill them with:  npm run keys:generate >> .env   (then delete these empty lines)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
REGISTRATION_CHALLENGE_HMAC_KEY=
LOGIN_CHALLENGE_HMAC_KEY=
EMAIL_CHANGE_HMAC_KEY=
DELETION_CHALLENGE_HMAC_KEY=
LOG_PSEUDONYM_HMAC_KEY=
# Cursor key ring "kid:key,kid:key"; the active kid must be in the ring.
USER_LIST_CURSOR_ACTIVE_KEY_ID=
USER_LIST_CURSOR_HMAC_KEYS=
